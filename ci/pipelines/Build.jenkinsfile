def version = "0.0.0"
def profile = "vs2022.conanprofile"
def packageNameInterface = "rest-api-core"
def packageNameTestUtilities = "rest-api-core-test-utilities"
def folderTestUtilities = "RESTAPICoreTestUtilities"
def archs = ['x86', 'x86_64']
def configs = ['Debug', 'Release']

@Library('aid-pipeline-utils@1.0.23') _
   
pipeline
{
	agent
	{
		label 'lib-build'
	}

	environment
	{
		PATH = "${env.USERPROFILE}\\.venvs\\conan2\\Scripts;${env.PATH}"
	}

	parameters
	{
		string(	name: 'tag',
 				description: 'Version to build (must match the version of the tag that will be checked out), leave blank for checkout of current branch',
 				defaultValue: '',
 				trim: true)
 
 		booleanParam( name: 'stable',
 					  description: 'Show if generated library should be uploaded as stable or testing',
 					  defaultValue: false )
 		
 		booleanParam( name: 'uploadPackage',
 					  description: 'Whether or not to upload conan package',
 					  defaultValue: false )
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				cleanupWorkspace()
 				script 
 				{
 					if (params.tag == '')
 					{
 						checkoutFromGIT()
 					}
 					else
 					{
 						version = params.tag
 						checkoutFromGIT(scm.userRemoteConfigs[0].url, "v${version}", true)
 					}
 				}
			}
		}
		
		stage('Build')
		{	
			steps
			{
				script
				{
					archs.each
						{ arch ->
							configs.each
							{ config ->
								stage("Build ${config}|${arch}")
								{
									def buildFolder = "build/${arch}-${config.toLowerCase()}"
									bat script: "conan install . --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}", label: 'Installing dependencies'
									bat script: "conan build . --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}", label: 'Building'
									bat script: "conan export-pkg . --name=${packageNameInterface} --version=${version} --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}", label: "Exporting package ${packageNameInterface}/${version}"
									bat script: "conan export-pkg ./test/${folderTestUtilities}/conanfile.py --name=${packageNameTestUtilities} --version=${version} --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}", label: "Exporting package ${packageNameTestUtilities}/${version}"
									dir("${buildFolder}/bin/${config}")
									{
										bat "RESTAPICoreTest.exe --gtest_output=xml:RESTAPICoreTest.xml"
									}
							}
						}
					}
				}
			}
		}
		
		stage('Test Packages')
		{
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							bat script: "conan test test_package/conanfile.py ${packageNameInterface}/${version} --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}", label: "Testing test_package for ${packageNameInterface}"
							bat script: "conan test test/${folderTestUtilities}/test_package/conanfile.py ${packageNameTestUtilities}/${version} --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}", label: "Testing test_package for ${packageNameTestUtilities}"
						}
					}
				}
			}
		}

		stage('Deploy')
		{
			when
			{
				expression { params.uploadPackage }
			}
			steps
			{

				bat script: "conan upload ${packageNameInterface}/${version} -r aid-conan-production-local --confirm", label: "Uploading ${packageNameInterface} package to Artifactory"
				bat script: "conan upload ${packageNameTestUtilities}/${version} -r aid-conan-production-local --confirm", label: "Uploading ${packageNameTestUtilities} package to Artifactory"
			}
		}	
	}
	
	post
	{
		always
		{
			junit allowEmptyResults: true, testResults: "build/**/RESTAPICoreTest.xml"
		}
	}
}